# Values from terraform output -json runtime
AWS_REGION=us-east-2
PILOT_HOSTNAME=
S3_BUCKET=
SQS_INGEST_QUEUE_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=

# ECR references by digest repo@sha256:...
API_IMAGE=
WEB_IMAGE=
RAG_ENGINE_IMAGE=
INGEST_WORKER_IMAGE=

# Generate a different value for each entry on the host with openssl rand -hex 32
POSTGRES_PASSWORD=
RAGSIS_APP_DB_PASSWORD=
RAGSIS_WORKER_DB_PASSWORD=
INTERNAL_SERVICE_SECRET=

# Waitlist (/waitlist): its own Turso database, independent of the app's PostgreSQL.
# Token for this database only (turso db tokens create waitlist-ragis), never an organization-wide one.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Verified Amazon SES sender for the waitlist confirmation email.
# Empty = sign-ups are stored without confirming the email.
WAITLIST_EMAIL_FROM=
