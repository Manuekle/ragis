# Valores de terraform output -json runtime
AWS_REGION=us-east-2
PILOT_HOSTNAME=
S3_BUCKET=
SQS_INGEST_QUEUE_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=

# Referencias de ECR con digest repo@sha256:...
API_IMAGE=
WEB_IMAGE=
RAG_ENGINE_IMAGE=
INGEST_WORKER_IMAGE=

# Genera un valor distinto para cada entrada en el host con openssl rand -hex 32
POSTGRES_PASSWORD=
RAGSIS_APP_DB_PASSWORD=
RAGSIS_WORKER_DB_PASSWORD=
INTERNAL_SERVICE_SECRET=

# Waitlist (/waitlist): base Turso propia, independiente de PostgreSQL de la app.
# Token de solo esta base (turso db tokens create waitlist-ragis), nunca uno de la organización.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Remitente verificado en Amazon SES para el correo de confirmación de la lista de espera.
# Vacío = los registros se guardan sin confirmar el correo.
WAITLIST_EMAIL_FROM=
