# Copiar a .env y completar (scripts/dev-env.sh genera valores aleatorios).
POSTGRES_PASSWORD=
RAGSIS_APP_DB_PASSWORD=
RAGSIS_WORKER_DB_PASSWORD=
INTERNAL_SERVICE_SECRET=
JWT_DEV_SECRET=
# dev | oidc  (oidc: Cognito u otro IdP; requiere OIDC_ISSUER y OIDC_AUDIENCE)
AUTH_MODE=dev
OIDC_ISSUER=
# client_id del IdP: audiencia que valida la API y client_id del BFF web
OIDC_AUDIENCE=
OIDC_CLIENT_SECRET=
# Demo en la portada. Usa una URL HTTPS de reservas o un correo para recibir solicitudes.
DEMO_BOOKING_URL=
CONTACT_EMAIL=
# Lista de espera (/waitlist): base de datos Turso. Vacío = no se guardan registros.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Confirmación de correo de la lista de espera. Remitente verificado en Amazon SES: con él, cada
# registro recibe un enlace y solo entra en la lista al abrirlo. Vacío en local: no se envía nada
# y el enlace aparece en la página y en el log (WAITLIST_EMAIL_TEST=1, valor por defecto de Compose).
# WAITLIST_EMAIL_FROM=
# local | bedrock | ollama
AI_DEFAULT_PROVIDER=local
AI_EMBEDDING_MODEL=local-hash-1024@v1
AI_GENERATION_MODEL=local-extractive@v1
AI_RERANK_MODEL=local-lexical-rerank@v1
OLLAMA_BASE_URL=http://host.docker.internal:11434
# none | clamav
MALWARE_SCANNER=none
# none | textract  (OCR de PDFs escaneados)
OCR_PROVIDER=none
# RAG-04 multimodal. Parser: native | docling (requiere el paquete `docling` en la imagen del worker).
PARSER_PREFERENCE=native
# VLM para describir figuras en ingesta (vacío = solo captions/alt text).
# Ej.: bedrock-nova-lite@v1, bedrock-claude-sonnet-5-5@v1, ollama-qwen3-vl-8b@v1 (local, apto para restricted)
AI_VISION_MODEL=
# Resumen de tablas con el modelo de generación (cifras verificadas contra la tabla).
INGEST_TABLE_SUMMARIES=false
# auto | off — adjunta imágenes de figuras citadas si el generador tiene visión.
RAG_VLM_ENHANCED=auto
# RAG-05 GraphRAG: modelo de extracción de entidades/relaciones (vacío = sin grafo). Solo aplica a tenants con
# grafo habilitado (plan business/private o organizations.graph_mode='on').
# Ej.: local-graph-heuristic@v1 (determinista, offline), ollama-qwen3-8b@v1, bedrock-claude-sonnet-5-5@v1
AI_GRAPH_MODEL=local-graph-heuristic@v1
# Vacío = sin trazas. Con `make up-obs`: http://jaeger:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Ragsis Sign (ADR-024). native por defecto. local solo simula firmas en desarrollo.
# ESIGN_PROVIDER=native
# ESIGN_WEBHOOK_SECRET=
# Secreto estable del sello Ed25519 (mín. 32 caracteres). Por defecto se deriva de INTERNAL_SERVICE_SECRET.
# SIGNATURE_SEAL_SECRET=
# Remitente verificado de Amazon SES. Vacío en desarrollo para usar la invitación de prueba.
# SIGNATURE_EMAIL_FROM=
# Base pública para invitaciones, comprobación de evidencia y enlaces compartidos.
# PUBLIC_BASE_URL=http://localhost:3000

# Conectores CON-01 (ADR-025): Gmail (personal), Slack y ClickUp (empresa). Guía: docs/connectors-setup.md
# Redirect URI a registrar en los tres proveedores: <PUBLIC_BASE_URL>/connect/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# CLICKUP_CLIENT_ID=
# CLICKUP_CLIENT_SECRET=
# Clave AES-256 de los tokens (obligatoria en producción): openssl rand -base64 32
# CONNECTOR_ENCRYPTION_KEY=
# Datos simulados sin cuentas reales (solo desarrollo; prohibido en producción).
# CONNECTORS_DEMO=1
# CONNECTOR_SYNC_INTERVAL_MINUTES=30
