# Copy to .env and fill in (scripts/dev-env.sh generates random values).
POSTGRES_PASSWORD=
RAGSIS_APP_DB_PASSWORD=
RAGSIS_WORKER_DB_PASSWORD=
INTERNAL_SERVICE_SECRET=
JWT_DEV_SECRET=
# dev | oidc  (oidc: Cognito or another IdP; requires OIDC_ISSUER and OIDC_AUDIENCE)
AUTH_MODE=dev
OIDC_ISSUER=
# IdP client_id: audience the API validates and client_id of the web BFF
OIDC_AUDIENCE=
OIDC_CLIENT_SECRET=
# Demo on the landing page. Use an HTTPS booking URL or an email to receive requests.
DEMO_BOOKING_URL=
CONTACT_EMAIL=
# Waitlist (/waitlist): Turso database. Empty = sign-ups are not stored.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Waitlist email confirmation. Verified sender in Amazon SES: with it, each sign-up gets a link
# and only enters the list when it is opened. Empty locally: nothing is sent and the link
# appears on the page and in the log (WAITLIST_EMAIL_TEST=1, the Compose default).
# WAITLIST_EMAIL_FROM=
# local | bedrock | ollama
AI_DEFAULT_PROVIDER=local
AI_EMBEDDING_MODEL=local-hash-1024@v1
AI_GENERATION_MODEL=local-extractive@v1
AI_RERANK_MODEL=local-lexical-rerank@v1
OLLAMA_BASE_URL=http://host.docker.internal:11434
# none | clamav
MALWARE_SCANNER=none
# none | textract  (OCR for scanned PDFs)
OCR_PROVIDER=none
# RAG-04 multimodal. Parser: native | docling (requires the `docling` package in the worker image).
PARSER_PREFERENCE=native
# VLM to describe figures during ingestion (empty = captions/alt text only).
# E.g.: bedrock-nova-lite@v1, bedrock-claude-sonnet-5-5@v1, ollama-qwen3-vl-8b@v1 (local, fit for restricted)
AI_VISION_MODEL=
# Table summaries with the generation model (figures verified against the table).
INGEST_TABLE_SUMMARIES=false
INGEST_EQUATION_ANALYSIS=false
# none | transcribe  (speech to text for audio recordings, Amazon Transcribe; ADR-030)
TRANSCRIPTION_PROVIDER=none
# Empty = automatic language detection among TRANSCRIPTION_LANGUAGE_OPTIONS. E.g.: es-US
TRANSCRIPTION_LANGUAGE=
# auto | off — attaches images of cited figures if the generator has vision.
RAG_VLM_ENHANCED=auto
# RAG-05 GraphRAG: entity/relation extraction model (empty = no graph). Only applies to tenants with the
# graph enabled (business/private plan or organizations.graph_mode='on').
# E.g.: local-graph-heuristic@v1 (deterministic, offline), ollama-qwen3-8b@v1, bedrock-claude-sonnet-5-5@v1
AI_GRAPH_MODEL=local-graph-heuristic@v1
# Empty = no traces. With `make up-obs`: http://jaeger:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Ragsis Sign (ADR-024). native by default. local only simulates signatures in development.
# ESIGN_PROVIDER=native
# ESIGN_WEBHOOK_SECRET=
# Stable secret for the Ed25519 seal (min. 32 characters). Derived from INTERNAL_SERVICE_SECRET by default.
# SIGNATURE_SEAL_SECRET=
# Verified Amazon SES sender. Empty in development to use the test invitation.
# SIGNATURE_EMAIL_FROM=
# Public base for invitations, evidence checks and shared links.
# PUBLIC_BASE_URL=http://localhost:3000

# CON-01 connectors (ADR-025): Gmail (personal), Slack and ClickUp (company). Guide: docs/connectors-setup.md
# Redirect URI to register with all three providers: <PUBLIC_BASE_URL>/connect/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# CLICKUP_CLIENT_ID=
# CLICKUP_CLIENT_SECRET=
# AES-256 key for the tokens (required in production): openssl rand -base64 32
# CONNECTOR_ENCRYPTION_KEY=
# Simulated data without real accounts (development only; forbidden in production).
# CONNECTORS_DEMO=1
# CONNECTOR_SYNC_INTERVAL_MINUTES=30
